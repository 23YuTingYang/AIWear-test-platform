{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["code", "message", "data"],
  "properties": {
    "code": {
      "type": "integer"
    },
    "message": {
      "type": "string"
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "sendTo": {
              "type": "string"
            },
            "expireTime": {
              "type": "integer"
            },
            "userId": {
              "type": "integer"
            },
            "username": {
              "type": "string"
            },
            "email": {
              "type": ["string", "null"]
            },
            "token": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "additionalProperties": true
}
