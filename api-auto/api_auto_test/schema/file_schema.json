{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["code", "message", "data"],
  "properties": {
    "code": {
      "type": "integer"
    },
    "message": {
      "type": "string"
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "saveUrl": {
              "type": "string"
            },
            "fileName": {
              "type": "string"
            },
            "fileSize": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "userId": {
                "type": "integer"
              },
              "fileName": {
                "type": "string"
              },
              "fileSize": {
                "type": "integer"
              },
              "ossUrl": {
                "type": "string"
              },
              "filePath": {
                "type": "string"
              },
              "similarity": {
                "type": ["number", "integer"]
              }
            },
            "additionalProperties": true
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
