  "properties": {
    "code": {
      "type": "integer"
    },
    "message": {
      "type": "string"
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "userId": {
                "type": "integer"
              },
              "action": {
                "type": "string"
              },
              "inputOssUrl1": {
                "type": ["string", "null"]
              },
              "inputOssUrl2": {
                "type": ["string", "null"]
              },
              "instruction": {
                "type": ["string", "null"]
              },
              "resultUrl": {
                "type": ["string", "null"]
              },
              "outputOssUrl": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": true
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
